{
  "name": "make-agent",
  "type": "module",
  "version": "0.3.5",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "bin": {
    "make-agent": "./dist/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bitteprotocol/make-agent"
  },
  "bugs": {
    "url": "https://github.com/bitteprotocol/make-agent/issues"
  },
  "homepage": "https://docs.bitte.ai/agents/make-agent",
  "scripts": {
    "dev": "tsx ./src/index.ts dev",
    "build": "tsup ./src/index.ts --format cjs,esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "lint": "prettier --check '{src,tests}/**/*.{js,ts}' && eslint . --ignore-pattern dist/",
    "fmt": "prettier --write '{src,tests}/**/*.{js,ts}' && pnpm run lint --fix",
    "test": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "ai",
    "agent",
    "cli"
  ],
  "author": "Bitte Team",
  "license": "MIT",
  "dependencies": {
    "@apidevtools/swagger-parser": "^12.0.0",
    "@types/express": "^5.0.3",
    "@typescript-eslint/eslint-plugin": "^8.42.0",
    "ajv": "^8.17.1",
    "ajv-draft-04": "^1.0.0",
    "borsh": "^2.0.0",
    "commander": "^12.1.0",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "inquirer": "^12.9.4",
    "is-port-reachable": "^4.0.0",
    "js-sha256": "^0.11.1",
    "near-api-js": "^5.1.1",
    "open": "^10.2.0"
  },
  "devDependencies": {
    "@types/inquirer": "^9.0.9",
    "@types/node": "^24.3.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.34.0",
    "eslint-plugin-import": "^2.32.0",
    "prettier": "^3.6.2",
    "tsup": "^8.5.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
